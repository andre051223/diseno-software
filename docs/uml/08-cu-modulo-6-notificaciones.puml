@startuml
!include estilo.iuml
left to right direction

actor "Temporizador\ndel sistema" as TMP <<actor temporal>>
actor "Coordinador\nde agenda" as COO

rectangle "Notificaciones y recordatorios" {
  usecase "CU-15, CU-16, CU-17\nConfirmar, reprogramar\no cancelar cita (módulo 4)" as CUCITA
  usecase "CU-24 Notificar cambio\nde la cita (RF-24)" as CU24
  usecase "CU-25 Enviar recordatorio\n48 horas antes (RF-25)" as CU25
  usecase "CU-26 Responder\nrecordatorio (RF-26)" as CU26
  usecase "CU-11 Registrar novedad\ndel médico (módulo 3)" as CU11
  usecase "CU-27 Avisar cancelación\npor novedad (RF-27)" as CU27
}
actor "Paciente" as PAC

TMP --> CU25
COO --> CU11
CUCITA ..> CU24 : <<include>>
CU11 <.. CU27 : <<extend>>\n[hay citas asignadas\nen el periodo]
CU24 -- PAC
CU25 -- PAC
CU27 -- PAC
CU26 <-- PAC
@enduml
