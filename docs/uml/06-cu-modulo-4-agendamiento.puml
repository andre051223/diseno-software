@startuml
!include estilo.iuml
left to right direction
skinparam ranksep 90

actor "Paciente" as PAC
actor "Personal de\nagendamiento" as AGE

rectangle "Agendamiento de citas" {
  usecase "CU-12 Consultar\ndisponibilidad (RF-12)" as CU12
  usecase "CU-15 Confirmar cita y\ngenerar comprobante (RF-15)" as CU15
  usecase "CU-16 Reprogramar cita\n(RF-16)" as CU16
  usecase "CU-17 Cancelar cita\n(RF-17)" as CU17
  usecase "CU-19 Registrar canal\nde origen (RF-19)" as CU19
  usecase "CU-14 Bloquear espacio\ndurante cinco minutos (RF-14)" as CU14
  usecase "CU-18 Verificar una cita activa\npor especialidad (RF-18)" as CU18
  usecase "CU-13 Impedir la doble\nreserva (RF-13)" as CU13
  usecase "CU-20 Registrar en bitácora\nde auditoría (RF-20)" as CU20
}

PAC --> CU12
AGE --> CU12
PAC --> CU15
AGE --> CU15
PAC --> CU16
AGE --> CU16
PAC --> CU17
AGE --> CU17

CU15 ..> CU14 : <<include>>
CU15 ..> CU18 : <<include>>
CU15 ..> CU13 : <<include>>
CU16 ..> CU13 : <<include>>
CU15 ..> CU20 : <<include>>
CU16 ..> CU20 : <<include>>
CU17 ..> CU20 : <<include>>
CU15 <.. CU19 : <<extend>>\n[la registra personal\ndel hospital]
@enduml
