@startuml
!include estilo.iuml
left to right direction

actor "Usuario del sistema" as USR
actor "Paciente" as PAC
actor "Administrador" as ADM
USR <|-- PAC

rectangle "Autenticación y control de acceso" {
  usecase "CU-01 Iniciar sesión\n(RF-01)" as CU01
  usecase "CU-03 Bloquear cuenta y\navisar al titular\n(RF-03)" as CU03
  usecase "CU-04 Recuperar contraseña\n(RF-04)" as CU04
  usecase "CU-02 Asignar rol a\nuna cuenta interna\n(RF-02)" as CU02
}

USR --> CU01
PAC --> CU04
ADM --> CU02
CU03 .> CU01 : <<extend>>\n[tres intentos\nfallidos seguidos]
note right of CU03 : Bloqueo de 15 minutos\ny aviso al correo registrado.
note right of CU04 : Enlace de un solo uso\ncon vigencia de 30 minutos.
@enduml
