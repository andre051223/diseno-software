@startuml
!include estilo.iuml
left to right direction

actor "Paciente" as PAC
actor "Personal de\nagendamiento" as AGE

rectangle "Validación de cobertura" {
  usecase "CU-15 Confirmar cita\n(módulo 4)" as CU15
  usecase "CU-21 Validar vigencia\ny cobertura (RF-21)" as CU21
  usecase "CU-22 Ofrecer atención\ncomo particular (RF-22)" as CU22
  usecase "CU-23 Dejar cita pendiente\nde validación y reintentar (RF-23)" as CU23
}
actor "Aseguradora" as ASE <<sistema externo>>
actor "Temporizador\ndel sistema" as TMP <<actor temporal>>

PAC --> CU15
AGE --> CU15
CU15 ..> CU21 : <<include>>
CU21 <.. CU22 : <<extend>>\n[afiliación no vigente\no sin cobertura]
CU21 <.. CU23 : <<extend>>\n[sin respuesta\nen 10 segundos]
CU21 --> ASE
CU23 <-- TMP
@enduml
