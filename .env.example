# Cadena de conexión de PostgreSQL (Neon). Con la integración de Neon en Vercel se obtiene con `vercel env pull`.
DATABASE_URL="postgresql://usuario:contrasena@servidor-pooler.neon.tech/neondb?sslmode=require"
# Conexión directa (sin pooler); la usan las migraciones y la semilla. Opcional.
DATABASE_URL_UNPOOLED="postgresql://usuario:contrasena@servidor.neon.tech/neondb?sslmode=require"
# Base PostgreSQL exclusiva para `npm test` y `npm run test:e2e`; se BORRA en cada ejecución.
DATABASE_URL_PRUEBAS="postgresql://usuario:contrasena@servidor.neon.tech/pruebas?sslmode=require"
SESSION_SECRET="cambie-este-valor-por-un-secreto-de-al-menos-32-caracteres"
TAREAS_TOKEN="cambie-este-token"
APP_URL="http://localhost:3000"
